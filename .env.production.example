# =====================================================================
# Tango Gestão e Créditos ERP - Variáveis de Ambiente de Produção (VPS)
# Copie este ficheiro para .env antes de iniciar o servidor:
# cp .env.production.example .env
# =====================================================================

# Porta e Ambiente do Servidor
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------
# Base de Dados PostgreSQL
# ---------------------------------------------------------------------
# Se usar Docker Compose incluído (Recomendado):
DATABASE_URL=postgresql://tango_user:tango_pass_segura_2026@db:5432/tangodb

# Se usar PostgreSQL instalado nativamente no Ubuntu da VPS:
# DATABASE_URL=postgresql://tango:SuaSenhaSegura@localhost:5432/tangodb

# Se usar Neon Cloud Serverless (externo):
# DATABASE_URL=postgresql://neondb_owner:npg_xyz@ep-cool-fog-123.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Credenciais usadas pelo Docker Compose caso utilize o serviço 'db':
DB_USER=tango_user
DB_PASSWORD=tango_pass_segura_2026
DB_NAME=tangodb

# ---------------------------------------------------------------------
# Segredos de Segurança do Tango Master
# ---------------------------------------------------------------------
# Chave global de sincronização das empresas (gere uma chave forte, ex: openssl rand -hex 24):
TANGO_SYNC_SECRET=tango_sync_segredo_mestre_2026_producao

# Chave mestra do painel administrativo Master Gen (idêntica à configurada na Vercel):
TANGO_MASTER_SECRET=TangoMaster#2026!ChaveForteHostinger

# URL pública da sua aplicação no domínio da VPS e na Vercel:
TANGO_MASTERGEN_URL=http://tangogestaoecreditos.tech
VERCEL_CLOUD_URL=https://tango-gestao-creditos.vercel.app
VPS_IP_URL=http://191.215.45.104
VPS_DOMAIN_URL=http://tangogestaoecreditos.tech

# Origens autorizadas para chamadas via Browser (CORS - Comunicação mútua Vercel & VPS):
TANGO_ALLOWED_ORIGINS=https://tango-gestao-creditos.vercel.app,http://191.215.45.104,http://191.215.45.104:3000,http://tangogestaoecreditos.tech,https://tangogestaoecreditos.tech,http://localhost:3000,http://localhost:8081

# ---------------------------------------------------------------------
# Alertas e Notificações (Opcional)
# ---------------------------------------------------------------------
# Webhook para alertas de segurança críticos (Discord, Slack ou n8n):
# TANGO_SECURITY_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TANGO_SECURITY_WEBHOOK_SECRET=
