{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "8081",
        "--strictPort"
      ],
      "port": 8081
    },
    {
      "name": "vercel-web-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        "vercel-web",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "master-admin-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        "dist-admin",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    },
    {
      "name": "web-dev-synctest",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "8081",
        "--strictPort"
      ],
      "port": 8081,
      "env": {
        "TANGO_DEV_API_PROXY": "http://localhost:3999"
      }
    }
  ]
}
