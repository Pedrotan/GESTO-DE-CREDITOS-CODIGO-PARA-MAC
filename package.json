{
  "name": "tango-gestao-erp",
  "productName": "Tango Gestao de Creditos",
  "private": true,
  "version": "3.0.2",
  "description": "Sistema de Gestão de Crédito",
  "author": "DIGITAL NORTE - COMÉRCIO E PRESTAÇÃO DE SERVIÇOS, (SU), LDA",
  "type": "module",
  "overrides": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "tar": "7.5.16",
    "minimatch": "^3.0.5",
    "semver": "^7.5.4"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --port 8081 --strictPort",
    "rebuild": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "build": "node build.js",
    "build:web": "node scripts/build-vercel.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.strict-domain.json --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:electron": "node scripts/run-electron-integration.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && concurrently --raw -k -s command-1 \"npm run dev\" \"wait-on http://localhost:8081 && cross-env TANGO_RENDERER_SANDBOX=false electron .\"",
    "electron:dev:clean": "npm run clean-data && npm run electron:dev",
    "electron dev": "npm run electron:dev",
    "eletron dev": "npm run electron:dev",
    "eletron:dev": "npm run electron:dev",
    "electron": "npm run electron:dev",
    "eletron": "npm run electron:dev",
    "electron:tango": "npm run stop-apps && npm run build:electron && concurrently --raw -k -s command-1 \"npm run dev\" \"wait-on http://localhost:8081 && cross-env TANGO_RENDERER_SANDBOX=false electron . --tango-master\"",
    "build:electron": "node scripts/generate-sql-allowlist.mjs && vite build --config vite.config.electron.ts",
    "build:electron:admin": "vite build --config vite.config.electron.admin.ts",
    "stop-apps": "powershell -nop -c \"Get-Process electron, Tango*, Angola*, rcedit-x64 -EA 0 | Stop-Process -Force; $p = (Get-NetTCPConnection -LocalPort 8081 -ErrorAction SilentlyContinue).OwningProcess; if ($p) { Stop-Process -Id $p -Force -ErrorAction SilentlyContinue }; sleep 1\"",
    "clean": "powershell -nop -c \"'release','dist','dist-electron' | % { if (Test-Path $_) { rm $_ -Recurse -Force -EA 0 } }\"",
    "build:erp": "npm run stop-apps && npm run build && npm run build:electron && node scripts/package-win.mjs",
    "build:mac": "npm run build && npm run build:electron && electron-builder --mac --arm64",
    "build:mac:universal": "npm run build && npm run build:electron && electron-builder --mac --universal",
    "build:master": "npm run stop-apps && vite build --config vite.config.admin.ts && npm run build:electron:admin && node scripts/package-win.mjs --config electron-builder-admin.json",
    "build:master:mac": "vite build --config vite.config.admin.ts && npm run build:electron:admin && electron-builder --config electron-builder-admin.json --mac --arm64",
    "build:all:mac": "npm run clean:mac && npm run rebuild && npm run build:mac && npm run build:master:mac",
    "build:all": "npm run clean:mac && npm run build:erp && npm run build:master",
    "build:all:win": "node scripts/build-instaladores.mjs",
    "instaladores": "node scripts/build-instaladores.mjs",
    "clean:mac": "rm -rf release dist dist-electron release-admin dist-admin dist-electron-admin",
    "clean:win": "powershell -nop -c \"'dist','dist-electron','dist-admin','dist-electron-admin' | % { if (Test-Path $_) { rm $_ -Recurse -Force -EA 0 } }\"",
    "clean:artifacts": "powershell -noprofile -command \"$paths = @('release-admin', 'dist-admin', 'dist-electron-admin', 'release/win-unpacked'); foreach ($p in $paths) { if (Test-Path $p) { Remove-Item -Path $p -Recurse -Force -ErrorAction SilentlyContinue } }\"",
    "clean-data": "node scripts/clean-app-data.cjs",
    "stop-apps:mac": "pkill -f 'Tango Gestão e Créditos ERP' || true",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@djosekispy/nifvalidation": "github:Djosekispy/nifvalidation",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "@types/nodemailer": "^7.0.9",
    "@types/qrcode": "^1.5.6",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3-multiple-ciphers": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.29.2",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.4.2",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "react-window": "^2.2.6",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "sql.js": "^1.13.0",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "vaul": "^0.9.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "app-builder-lib": "^26.4.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "33.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.1",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.sistema.tangoerp",
    "productName": "Tango Gestao de Creditos",
    "compression": "normal",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public_key.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.cjs",
      "type": "commonjs"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3-multiple-ciphers/**/*",
      "**/node_modules/bindings/**/*",
      "**/node_modules/file-uri-to-path/**/*",
      "**/*.node",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "pkg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "pkg": {
      "installLocation": "/Applications",
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": false,
      "identity": null,
      "scripts": "build/pkg-scripts"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "build/icon.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "asar": true,
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": true,
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tango Gestao de Creditos",
      "artifactName": "TangoGestaoCreditos_Setup.${ext}",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "warningsAsErrors": false
    }
  }
}
